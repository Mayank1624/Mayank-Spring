<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- bean definitions here -->
    
<!--    Autowiring->eska use alag se ref ya inner been na bnana bnana pade esliye hota hai autowiring karte time bean ka nam aur reference variabe ka
     name same hona chahiye esse direct dependencies injection ho jata hai  jabautowire byName ho Agar autowire bytag hai to been ka nam
      difference bhi ho sakta hai--> 
      
     <bean name="address1" class="seekho.spring.model.Address">
     
     <property name="city" value="ballia" />
     <property name="state" value="up" />
     
     </bean>
    
    
    
    <bean name="emp1" class="seekho.spring.model.Employee" autowire="byType">
     
    <property name="id" value="1624"/>
    <property name="name" value="Atif"/>
    <property name="gender" value="Male"/>
   
     
    </bean>
    
    
    
    
    
    

</beans>